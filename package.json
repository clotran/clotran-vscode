{
  "name": "clotran",
  "displayName": "clotran",
  "description": "clotran -- Clojure hosted on Fortran: the language server, a REPL, evaluate at the cursor, load, compile.",
  "version": "0.1.0",
  "publisher": "clotran",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/clotran/clotran-vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.cljf",
    "workspaceContains:**/package.edn",
    "onDebugResolve:clotran",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "clojure",
        "extensions": [
          ".cljf"
        ]
      }
    ],
    "commands": [
      {
        "command": "clotran.jackIn",
        "title": "clotran: Start a REPL (jack-in)"
      },
      {
        "command": "clotran.evalForm",
        "title": "clotran: Evaluate the form at the cursor"
      },
      {
        "command": "clotran.evalSelection",
        "title": "clotran: Evaluate the selection"
      },
      {
        "command": "clotran.loadFile",
        "title": "clotran: Load this file (a Fortran file: rebuild its package)"
      },
      {
        "command": "clotran.compileFile",
        "title": "clotran: Load and compile this file to native code"
      },
      {
        "command": "clotran.install",
        "title": "clotran: Install clotran (the release for this machine)"
      },
      {
        "command": "clotran.quit",
        "title": "clotran: Quit the REPL"
      }
    ],
    "keybindings": [
      {
        "command": "clotran.evalForm",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == clojure && !editorHasSelection"
      },
      {
        "command": "clotran.evalSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == clojure && editorHasSelection"
      },
      {
        "command": "clotran.loadFile",
        "key": "ctrl+alt+c l",
        "when": "editorTextFocus && (editorLangId == clojure || resourceExtname =~ /\\.(f90|f95|f03|f08|f)$/i)"
      },
      {
        "command": "clotran.compileFile",
        "key": "ctrl+alt+c k",
        "when": "editorTextFocus && editorLangId == clojure"
      },
      {
        "command": "clotran.jackIn",
        "key": "ctrl+alt+c j"
      }
    ],
    "configuration": {
      "title": "clotran",
      "properties": {
        "clotran.program": {
          "type": "string",
          "default": "",
          "description": "The clotran command. Empty: the clotran this extension carries (its build for this platform), else clotran on PATH, else where clotran's install script puts it."
        },
        "clotran.languageServer": {
          "type": "boolean",
          "default": true,
          "description": "Start clotran lsp for the workspace."
        }
      }
    },
    "debuggers": [
      {
        "type": "clotran",
        "label": "clotran",
        "languages": [
          "clojure"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .cljf file to run, relative to the workspace.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "clotran",
            "request": "launch",
            "name": "clotran: run this file",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "clotran: run a file",
            "body": {
              "type": "clotran",
              "request": "launch",
              "name": "clotran: ${1:main.cljf}",
              "program": "${workspaceFolder}/${1:src/app/main.cljf}",
              "cwd": "${workspaceFolder}"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "shadow-cljs release ext",
    "watch": "shadow-cljs watch ext",
    "test": "shadow-cljs compile test && node out/test.js",
    "package": "shadow-cljs release ext && vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.20",
    "@vscode/vsce": "^3.2.1",
    "@vscode/test-electron": "^2.4.1"
  }
}
